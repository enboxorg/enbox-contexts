{
  "name": "@enbox/contexts",
  "version": "0.1.0",
  "description": "Optional shared contexts, invitations, membership, and cross-device following for Enbox applications",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "clean": "rm -rf dist coverage",
    "build": "bun run clean && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit && tsc -p type-tests/tsconfig.json",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "check": "bun run lint && bun run typecheck && bun run test && bun run build",
    "prepublishOnly": "bun run build",
    "changeset": "changeset",
    "version": "changeset version && bun install",
    "release": "bun run check && changeset publish"
  },
  "homepage": "https://github.com/enboxorg/enbox-contexts#readme",
  "bugs": "https://github.com/enboxorg/enbox-contexts/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/enboxorg/enbox-contexts.git"
  },
  "license": "Apache-2.0",
  "contributors": [
    {
      "name": "Liran Cohen",
      "url": "https://github.com/LiranCohen"
    }
  ],
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@changesets/changelog-github": "0.5.2",
    "@changesets/cli": "2.29.8",
    "@enbox/api": "0.6.96",
    "@eslint/js": "9.3.0",
    "@types/node": "22.19.15",
    "@typescript-eslint/eslint-plugin": "8.72.0",
    "@typescript-eslint/parser": "8.72.0",
    "@vitest/coverage-v8": "3.2.4",
    "eslint": "9.7.0",
    "typescript": "5.9.3",
    "vitest": "3.2.4"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "enbox",
    "dwn",
    "contexts",
    "collaboration",
    "sharing",
    "invitations",
    "local-first",
    "e2ee"
  ]
}
